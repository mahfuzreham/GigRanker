APP_NAME=GigRanker
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gigranker.cheap

LOG_CHANNEL=stack

# Admin recipient for scheduled production health alerts.
ADMIN_EMAIL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# AI provider credentials: keep real values only in the server environment.
AI_PROVIDER=gemini
AI_TIMEOUT=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Payment credentials: server-side only.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BEP20_PAYMENT_ADDRESS=

# Application limits and credit costs.
AI_DAILY_GENERATION_LIMIT=100
MAX_PROJECTS_PER_USER=10
CREDITS_WEBSITE=10
CREDITS_PAGE=2
CREDITS_BLOG=3
CREDITS_REGENERATE=2
